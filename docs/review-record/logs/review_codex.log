   554	     <b>${ln.index??i}</b>${(ln.confidence!=null?`<span class="conf">${(ln.confidence*100).toFixed(1)}%</span>`:'')}
   555	     ${ln.text.replace(/</g,'&lt;')}</div>`).join('')
   556	    ||'<div style="color:var(--muted)">No text found.</div>';
