   678	@app.on_event("startup")
   679	def startup():
   680	    if state["force_tier"] == "rapidocr":
   681	        # test/ops mode: no paddle init at all; tier 2 spawns lazily on first request
   682	        log("skipping paddle init: --force-tier rapidocr (tier 2 only)")
   683	        state["warm"] = True
   684	        return
   685	    req = state["requested_device"]
   686	    if state["force_tier"] == "paddle-cpu":
   687	        candidates = ["cpu"]
   688	    elif req == "auto":
   689	        candidates = ["cpu"]
   690	        if paddle.device.is_compiled_with_cuda():
   691	            try:
   692	                if paddle.device.cuda.device_count() > 0:
   693	                    candidates = ["gpu:0", "cpu"]
   694	            except Exception:
   695	                pass
   696	    else:
   697	        candidates = [resolve_device(req)]
   698	
   699	    for i, dev in enumerate(candidates):
   700	        try:
   701	            model = init_model(dev)
   702	            if not warm_predict(model):
   703	                raise RuntimeError("prewarm predict failed")
   704	            state["model"] = model
   705	            state["device"] = dev
   706	            state["warm"] = True
   707	            state["fallback_active"] = i > 0
   708	            state["fallback_reason"] = (
   709	                f"GPU on this host not usable ({state['first_error']}), using {dev}" if i > 0 else None
   710	            )
   711	            log(f"initialized device={dev} lang={state['lang']} det={state['det_model'] or 'default'} "
   712	                f"rec={state['rec_model'] or 'default'} mkldnn={state['enable_mkldnn']} "
   713	                f"fallback_active={state['fallback_active']}")
   714	            return
   715	        except SystemExit:
   716	            raise
   717	        except Exception as exc:
   718	            state["error"] = f"{dev}: {exc}"
   719	            if i == 0:
   720	                state["first_error"] = str(exc)
   721	            log(f"init on {dev} failed: {exc}")
   722	    log("all device candidates failed")
