   103	def resolve_device(requested: str) -> str:
   104	    """Map CLI arg to a paddle device string."""
   105	    if requested == "cpu":
   106	        return "cpu"
   107	    compiled = paddle.device.is_compiled_with_cuda()
   108	    count = 0
   109	    if compiled:
   110	        try:
   111	            count = paddle.device.cuda.device_count()
   112	        except Exception:
   113	            count = 0
   114	    if requested == "auto":
   115	        return "gpu:0" if compiled and count > 0 else "cpu"
   116	    if requested == "gpu":
   117	        if not compiled:
   118	            raise SystemExit("GPU requested but this paddle build is CPU-only (paddlepaddle, not paddlepaddle-gpu). Reinstall with a GPU wheel.")
   119	        return "gpu:0"
   120	    if requested.startswith("gpu:"):
   121	        if not compiled:
   122	            raise SystemExit(f"GPU requested ({requested}) but this paddle build is CPU-only.")
   123	        return requested
   124	    raise SystemExit(f"Unknown device {requested!r} (use auto|cpu|gpu|gpu:N)")
