   336	function render(f,d){
   337	  $('jsonwrap').style.display='';
   338	  $('json').textContent=JSON.stringify(d,null,2);
   339	  window.__res=d;window.__sel=null;
   340	  const img=new Image();
   341	  img.onload=()=>{window.__img=img;window.__scale=Math.min(1,760/img.naturalWidth);
   342	    $('canvas').title='click a box to jump to its line';
   343	    drawBoxes(null);};
