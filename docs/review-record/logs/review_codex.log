   543	  $('json').textContent=JSON.stringify(d,null,2);
   544	  window.__res=d;window.__sel=null;
   545	  const img=new Image();
   546	  img.onload=()=>{window.__img=img;window.__scale=Math.min(1,760/img.naturalWidth);
   547	    $('canvas').title='click a box to jump to its line';
