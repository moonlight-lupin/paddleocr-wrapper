   525	async function run(f){
   526	  drop.innerHTML='<span style="opacity:.7">OCR running…</span>';
   527	  $('status').textContent=f.name+' ('+(f.size/1024).toFixed(0)+' KB)';
   528	  const fd=new FormData();fd.append('image',f);
   529	  try{
   530	    const r=await fetch('/ocr/upload',{method:'POST',body:fd});
   531	    const d=await r.json();
   532	    if(!r.ok){const msg=d.detail&&(d.detail.error||JSON.stringify(d.detail))||r.status;
   533	      $('status').innerHTML='<span style="color:var(--warn)">Failed: '+msg+'</span>';
   534	      $('result').classList.add('hidden');return;}
   535	    $('status').textContent=`${d.lines.length} line${d.lines.length===1?'':'s'} · `+(d.elapsed_s*1000).toFixed(0)+' ms · device '+d.device;
   536	    render(f,d);
   537	  }catch(err){$('status').innerHTML='<span style="color:var(--warn)">Upload failed: '+err+'</span>';}
   538	  finally{bindDrop();}
   539	}
