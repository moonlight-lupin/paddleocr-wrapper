   314	bindDrop();
   315	/* drag listeners ride on the drop element itself — attach once */
   316	['dragover','dragenter'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add('on');}));
   317	['dragleave','drop'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove('on');}));
   318	drop.addEventListener('drop',e=>{const f=e.dataTransfer.files[0];if(f)run(f);});
