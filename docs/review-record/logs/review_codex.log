   293	def ensure_fields(img: np.ndarray) -> tuple[dict, str]:
   294	    """Engine chain. Returns (fields, device_label). Raises HTTPException only if everything fails."""
   295	    ft = state["force_tier"]
   296	    if ft == "rapidocr":
   297	        fields, why = rapid_fields(img)
   298	        if fields is not None:
   299	            return fields, why
   300	        return tier3_fields(img, f"tier2 unavailable ({why})")
   301	    if ft == "paddle-cpu":
   302	        return tier3_fields(img, "forced paddle-cpu")
   303	    if ft == "gpu":
   304	        if state["model"] is None:
   305	            raise HTTPException(status_code=503, detail={"error": "model not initialized", "detail": state["error"]})
   306	        res = state["model"].predict(img)
   307	        return result_fields(res[0]), state["device"]
   308	    if state["model"] is None:
   309	        raise HTTPException(status_code=503, detail={"error": "model not initialized", "detail": state["error"]})
   310	    if state["device"] == "cpu":
   311	        # booted on CPU by request: chain ends here (paddle CPU is the last tier)
   312	        res = state["model"].predict(img)
   313	        return result_fields(res[0]), "cpu"
   314	    # tier 1: paddle GPU. Per-request retry keeps auto-recovery: a transient
   315	    # VRAM conflict repairs itself on the next request without a restart.
   316	    try:
   317	        res = state["model"].predict(img)
   318	        return result_fields(res[0]), state["device"]
   319	    except Exception as exc:
   320	        state["gpu_runtime_failures"] += 1
   321	        reason = f"GPU runtime failure ({state['gpu_runtime_failures']}): {exc}"
   322	        state["fallback_reason"] = reason
   323	        log(f"{reason}; descending engine chain")
   324	        fields, why = rapid_fields(img)
   325	        if fields is not None:
   326	            return fields, "rapidocr-cpu"
   327	        return tier3_fields(img, f"tier 2 unavailable ({why}); {reason}")
