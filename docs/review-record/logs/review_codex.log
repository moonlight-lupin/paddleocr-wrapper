   320	async function run(f){
   321	  drop.innerHTML='<span style="opacity:.7">OCR running…</span>';
   322	  $('status').textContent=f.name+' ('+(f.size/1024).toFixed(0)+' KB)';
   323	  const fd=new FormData();fd.append('image',f);
   324	  try{
   325	    const r=await fetch('/ocr/upload',{method:'POST',body:fd});
   326	    const d=await r.json();
   327	    if(!r.ok){const msg=d.detail&&(d.detail.error||JSON.stringify(d.detail))||r.status;
   328	      $('status').innerHTML='<span style="color:var(--warn)">Failed: '+msg+'</span>';
   329	      $('result').classList.add('hidden');return;}
   330	    $('status').textContent=`${d.lines.length} line${d.lines.length===1?'':'s'} · `+(d.elapsed_s*1000).toFixed(0)+' ms · device '+d.device;
   331	    render(f,d);
   332	  }catch(err){$('status').innerHTML='<span style="color:var(--warn)">Upload failed: '+err+'</span>';}
   333	  finally{bindDrop();}
   334	}
