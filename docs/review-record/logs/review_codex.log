   272	def tier3_fields(img: np.ndarray, reason: str) -> tuple[dict, str]:
   273	    """Tier 3: paddle CPU (existing standby path, lazily initialized)."""
   274	    if state["device"] == "cpu" and state["model"] is not None:
   275	        res = state["model"].predict(img)
   276	        return result_fields(res[0]), "cpu"
   277	    if state["model"] is None or state["device"] != "cpu":
   278	        log(f"initializing paddle CPU tier 3 ({reason})")
   279	        model = init_model("cpu")
   280	        if not warm_predict(model):
   281	            raise HTTPException(status_code=500, detail={"error": "predict failed: paddle CPU fallback prewarm failed"})
   282	        state["model"] = model
   283	        state["device"] = "cpu"
   284	        state["fallback_active"] = True
   285	        state["fallback_reason"] = reason
   286	    state["fallback_active"] = True
   287	    if not state["fallback_reason"]:
   288	        state["fallback_reason"] = reason
   289	    res = state["model"].predict(img)
   290	    return result_fields(res[0]), "cpu"
