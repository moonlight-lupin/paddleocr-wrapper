   660	def init_model(dev):
   661	    kwargs = dict(
   662	        lang=state["lang"],
   663	        device=dev,
   664	        enable_mkldnn=state["enable_mkldnn"],
   665	        use_doc_orientation_classify=False,
   666	        use_doc_unwarping=False,
   667	        use_textline_orientation=False,
   668	    )
   669	    # Optional explicit model overrides. When set, paddleocr auto-downloads
   670	    # the named model on first start. Note: explicit names make lang ignored.
   671	    if state.get("det_model"):
   672	        kwargs["text_detection_model_name"] = state["det_model"]
   673	    if state.get("rec_model"):
   674	        kwargs["text_recognition_model_name"] = state["rec_model"]
   675	    return PaddleOCR(**kwargs)
