   347	  $('lines').innerHTML=d.lines.map((ln,i)=>
   348	    `<div class="rowline ${ln.confidence!=null&&ln.confidence<.9?'low':''}" data-i="${ln.index}">
   349	     <b>${ln.index??i}</b>${(ln.confidence!=null?`<span class="conf">${(ln.confidence*100).toFixed(1)}%</span>`:'')}
   350	     ${ln.text.replace(/</g,'&lt;')}</div>`).join('')
   351	    ||'<div style="color:var(--muted)">No text found.</div>';
