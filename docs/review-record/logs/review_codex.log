    84	class _RingHandler(logging.Handler):
    85	    """Capture uvicorn/paddle log records into the ring buffer (no console echo)."""
    86	
    87	    def emit(self, record):
    88	        try:
    89	            log(f"[{record.levelname}] {record.getMessage()}", console=False)
    90	        except Exception:
    91	            pass
