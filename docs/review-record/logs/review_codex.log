   296	async function health(){try{
   297	  const d=await (await fetch('/health')).json();
   298	  const chips=[['status',d.status],['device',d.device+(d.fallback_active?' · fallback':'')],
   299	    ['models',(d.det_model||d.rec_model)?`${d.det_model||'default det'} + ${d.rec_model||'default rec'}`:'package default']];
   300	  chips.push(['versions',`paddle ${d.paddle_version} · paddleocr ${d.paddleocr_version} · cuda ${d.paddle_compiled_with_cuda}`]);
   301	  if(d.fallback_reason)chips.push(['reason',d.fallback_reason]);
   302	  $('chips').innerHTML=chips.map(([k,v])=>
   303	    `<span class="chip ${d.fallback_active&&k==='device'?'warn':''}">${k}: <b>${v}</b></span>`).join('');
   304	}catch(e){$('chips').innerHTML='<span class="chip warn">service unreachable</span>';}}
   305	health();setInterval(health,5000);
