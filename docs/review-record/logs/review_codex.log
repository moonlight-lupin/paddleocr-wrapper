   443	def warm_predict(model) -> bool:
   444	    """Run a tiny predict to prove the device actually works."""
   445	    img = np.full((64, 200, 3), 255, dtype=np.uint8)
   446	    cv2.putText(img, "warmup", (10, 40), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 0, 0), 2)
   447	    try:
   448	        model.predict(img)
   449	        return True
   450	    except Exception as exc:
   451	        log(f"prewarm predict failed: {exc}")
   452	        return False
   453	
   454	
   455	def init_model(dev):
   456	    kwargs = dict(
   457	        lang=state["lang"],
   458	        device=dev,
   459	        enable_mkldnn=state["enable_mkldnn"],
   460	        use_doc_orientation_classify=False,
   461	        use_doc_unwarping=False,
   462	        use_textline_orientation=False,
   463	    )
   464	    # Optional explicit model overrides. When set, paddleocr auto-downloads
   465	    # the named model on first start. Note: explicit names make lang ignored.
   466	    if state.get("det_model"):
   467	        kwargs["text_detection_model_name"] = state["det_model"]
   468	    if state.get("rec_model"):
   469	        kwargs["text_recognition_model_name"] = state["rec_model"]
   470	    return PaddleOCR(**kwargs)
   471	
   472	
   473	def ensure_predict(img):
   474	    """Predict, falling back to CPU once if a GPU run dies (init-time or runtime)."""
   475	    if state["model"] is None:
   476	        raise HTTPException(status_code=503, detail={"error": "model not initialized", "detail": state["error"]})
   477	    try:
   478	        return state["model"].predict(img)
   479	    except Exception as exc:
   480	        gpu_broken = state["device"] != "cpu" and state["requested_device"] == "auto"
   481	        if not gpu_broken:
   482	            raise HTTPException(status_code=500, detail={"error": "paddle predict failed", "detail": str(exc)}) from exc
   483	        log(f"GPU predict failed ({exc}); falling back to CPU")
   484	        try:
   485	            model = init_model("cpu")
   486	            if not warm_predict(model):
   487	                raise RuntimeError("CPU prewarm failed too")
   488	            state["model"] = model
   489	            state["device"] = "cpu"
   490	            state["fallback_active"] = True
   491	            state["fallback_reason"] = f"GPU runtime failure: {exc}"
   492	            return model.predict(img)
   493	        except Exception as exc2:
   494	            raise HTTPException(
   495	                status_code=500,
   496	                detail={"error": "predict failed on GPU and CPU fallback", "detail": str(exc2)},
   497	            ) from exc2
   498	
