   648	def warm_predict(model) -> bool:
   649	    """Run a tiny predict to prove the device actually works."""
   650	    img = np.full((64, 200, 3), 255, dtype=np.uint8)
   651	    cv2.putText(img, "warmup", (10, 40), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 0, 0), 2)
   652	    try:
   653	        model.predict(img)
   654	        return True
   655	    except Exception as exc:
   656	        log(f"prewarm predict failed: {exc}")
   657	        return False
