   562	/* box <-> line interactivity */
   563	function drawBoxes(hi){
   564	  const d=window.__res,img=window.__img;
   565	  if(!d||!img||!window.__scale)return;
   566	  const c=$('canvas'),s=window.__scale;
   567	  c.width=img.naturalWidth*s;c.height=img.naturalHeight*s;
   568	  const ctx=c.getContext('2d');
   569	  ctx.drawImage(img,0,0,c.width,c.height);
   570	  ctx.font=`${Math.max(10,11*s)}px ui-monospace,Consolas,monospace`;
   571	  d.lines.forEach(ln=>{
   572	    if(!ln.box)return;
   573	    const active=(hi!=null&&ln.index===hi)||(window.__sel!=null&&ln.index===window.__sel);
   574	    const p=ln.box.map(([x,y])=>[x*s,y*s]);
   575	    ctx.beginPath();ctx.moveTo(p[0][0],p[0][1]);
   576	    for(let i=1;i<4;i++)ctx.lineTo(p[i][0],p[i][1]);
   577	    ctx.closePath();
   578	    if(active){ctx.fillStyle='rgba(138,109,59,.34)';ctx.fill();}
   579	    ctx.lineWidth=Math.max(1,(active?3.2:1.3)*s);
   580	    ctx.strokeStyle=active?'rgba(166,124,46,1)':'rgba(138,109,59,.30)';
   581	    ctx.stroke();
   582	    if(active){ctx.fillStyle='rgba(166,124,46,1)';
   583	      ctx.fillText('#'+ln.index,p[0][0],Math.max(11*s,p[0][1]-4));}
   584	  });
   585	}
   586	function pointBoxDist(px,py,box){
   587	  let inside=false,minD=1e9;
   588	  for(let i=0;i<4;i++){
   589	    const [x1,y1]=box[i],[x2,y2]=box[(i+1)%4];
   590	    const dx=x2-x1,dy=y2-y1;
   591	    const t=Math.max(0,Math.min(1,((px-x1)*dx+(py-y1)*dy)/((dx*dx+dy*dy)||1e-9)));
   592	    const dd=Math.hypot(px-(x1+t*dx),py-(y1+t*dy));
   593	    if(dd<minD)minD=dd;
   594	    if(((y1>py)!==(y2>py))&&px<(x2-x1)*(py-y1)/((y2-y1)||1e-9)+x1)inside=!inside;
   595	  }
   596	  return inside?0:minD;
   597	}
   598	const LINES_=$('lines');
   599	LINES_.addEventListener('mouseover',e=>{const row=e.target.closest('.rowline');if(row)drawBoxes(+row.dataset.i);});
   600	LINES_.addEventListener('mouseout',e=>{if(!e.relatedTarget||!e.relatedTarget.closest('.rowline'))drawBoxes(null);});
   601	LINES_.addEventListener('click',e=>{
   602	  const row=e.target.closest('.rowline');if(!row)return;
   603	  const i=+row.dataset.i;
   604	  window.__sel=(window.__sel===i)?null:i;
   605	  LINES_.querySelectorAll('.rowline').forEach(r=>r.classList.toggle('sel',+r.dataset.i===window.__sel));
   606	  drawBoxes(null);
   607	});
   608	$('canvas').addEventListener('click',e=>{
   609	  const c=$('canvas');
   610	  if(!window.__res||!window.__scale)return;
   611	  const rc=c.getBoundingClientRect();
   612	  const px=(e.clientX-rc.left)*(c.width/rc.width);
   613	  const py=(e.clientY-rc.top)*(c.height/rc.height);
   614	  let best=null,bd=1e9;
   615	  window.__res.lines.forEach(ln=>{if(!ln.box)return;
   616	    const dd=pointBoxDist(px,py,ln.box);if(dd<bd){bd=dd;best=ln.index;}});
   617	  if(best==null||bd>30)return;
   618	  const row=LINES_.querySelector(`.rowline[data-i="${best}"]`);
   619	  if(row){window.__sel=(window.__sel===best)?null:best;
   620	    LINES_.querySelectorAll('.rowline').forEach(r=>r.classList.toggle('sel',+r.dataset.i===window.__sel));
   621	    drawBoxes(null);row.scrollIntoView({block:'nearest',behavior:'smooth'});}
   622	});
