   254	def rapid_fields(img: np.ndarray) -> tuple[dict | None, str]:
   255	    """Tier 2 attempt. Returns (fields, 'rapidocr-cpu') or (None, reason)."""
   256	    w = state["rapid_worker"]
   257	    if w is None:
   258	        return None, "tier2 disabled"
   259	    state["rapid"]["uses"] += 1
   260	    fields = w.call(img)
   261	    if fields is None:
   262	        return None, "tier2 call failed"
   263	    confs = [ln["confidence"] for ln in fields["lines"] if ln.get("confidence") is not None]
   264	    min_conf = min(confs) if confs else 0.0
   265	    if min_conf < state["conf_gate"]:
   266	        state["rapid"]["gated"] += 1
   267	        log(f"tier2 min_conf {min_conf:.3f} < gate {state['conf_gate']}; re-running on paddle CPU")
   268	        return None, f"tier2 conf gate (min_conf {min_conf:.3f})"
   269	    return fields, "rapidocr-cpu"
