   521	['dragover','dragenter'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add('on');}));
   522	['dragleave','drop'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove('on');}));
   523	drop.addEventListener('drop',e=>{const f=e.dataTransfer.files[0];if(f)run(f);});
