   184	class RapidWorker:
   185	    """Persistent rapid_worker.py child process, line-JSON protocol.
   186	
   187	    Child prints 'READY' once its engine is loaded, then one 'OCR {json}' line
   188	    per request. Any other stdout line is skipped as child-side noise.
   189	    """
   190	
   191	    def __init__(self, python_exe: str, script_path: str):
   192	        self.python_exe = python_exe
   193	        self.script_path = script_path
   194	        self.proc = None
   195	
   196	    def _spawn(self):
   197	        self.proc = subprocess.Popen(
   198	            [self.python_exe, self.script_path],
   199	            stdin=subprocess.PIPE,
   200	            stdout=subprocess.PIPE,
   201	            text=True,
   202	            encoding="utf-8",
   203	            cwd=os.path.dirname(os.path.abspath(self.script_path)) or None,
   204	        )
   205	        line = self.proc.stdout.readline()
   206	        if line.strip() != "READY":
   207	            raise RuntimeError(f"rapid worker handshake failed: {line[:200]!r}")
   208	        log("rapidocr tier spawned")
   209	
   210	    def call(self, img: np.ndarray) -> dict | None:
   211	        """Run OCR on a decoded BGR array. Returns fields dict or None on failure."""
   212	        ok, buf = cv2.imencode(".png", img)
   213	        if not ok:
   214	            return None
   215	        payload = json.dumps({"image": base64.b64encode(buf.tobytes()).decode("ascii")})
   216	        for attempt in (1, 2):  # one respawn allowed within a single request
   217	            try:
   218	                if self.proc is None or self.proc.poll() is not None:
   219	                    self.proc = None
   220	                    self._spawn()
   221	                self.proc.stdin.write(payload + "\n")
   222	                self.proc.stdin.flush()
   223	                while True:
   224	                    line = self.proc.stdout.readline()
   225	                    if not line:  # child died
   226	                        raise RuntimeError("rapid worker stdout closed")
   227	                    if line.startswith("OCR "):
   228	                        resp = json.loads(line[4:])
   229	                        if resp.get("ok"):
   230	                            return {"lines": resp["lines"], "text": resp["text"]}
   231	                        raise RuntimeError(f"rapid worker error: {resp.get('error')}")
   232	                    # skip noise lines
   233	                return None
   234	            except Exception as exc:
   235	                state["rapid"]["failures"] += 1
   236	                log(f"rapidocr tier attempt {attempt} failed: {exc}")
   237	                try:
   238	                    if self.proc is not None:
   239	                        self.proc.kill()
   240	                except Exception:
   241	                    pass
   242	                self.proc = None
   243	        return None
   244	
   245	    def stop(self):
   246	        try:
   247	            if self.proc is not None:
   248	                self.proc.kill()
   249	        except Exception:
   250	            pass
   251	        self.proc = None
   252	
