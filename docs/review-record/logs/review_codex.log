   357	/* box <-> line interactivity */
   358	function drawBoxes(hi){
   359	  const d=window.__res,img=window.__img;
   360	  if(!d||!img||!window.__scale)return;
   361	  const c=$('canvas'),s=window.__scale;
   362	  c.width=img.naturalWidth*s;c.height=img.naturalHeight*s;
   363	  const ctx=c.getContext('2d');
   364	  ctx.drawImage(img,0,0,c.width,c.height);
   365	  ctx.font=`${Math.max(10,11*s)}px ui-monospace,Consolas,monospace`;
   366	  d.lines.forEach(ln=>{
   367	    if(!ln.box)return;
   368	    const active=(hi!=null&&ln.index===hi)||(window.__sel!=null&&ln.index===window.__sel);
   369	    const p=ln.box.map(([x,y])=>[x*s,y*s]);
   370	    ctx.beginPath();ctx.moveTo(p[0][0],p[0][1]);
   371	    for(let i=1;i<4;i++)ctx.lineTo(p[i][0],p[i][1]);
   372	    ctx.closePath();
   373	    if(active){ctx.fillStyle='rgba(138,109,59,.34)';ctx.fill();}
   374	    ctx.lineWidth=Math.max(1,(active?3.2:1.3)*s);
   375	    ctx.strokeStyle=active?'rgba(166,124,46,1)':'rgba(138,109,59,.30)';
   376	    ctx.stroke();
   377	    if(active){ctx.fillStyle='rgba(166,124,46,1)';
   378	      ctx.fillText('#'+ln.index,p[0][0],Math.max(11*s,p[0][1]-4));}
   379	  });
   380	}
   381	function pointBoxDist(px,py,box){
   382	  let inside=false,minD=1e9;
   383	  for(let i=0;i<4;i++){
   384	    const [x1,y1]=box[i],[x2,y2]=box[(i+1)%4];
   385	    const dx=x2-x1,dy=y2-y1;
   386	    const t=Math.max(0,Math.min(1,((px-x1)*dx+(py-y1)*dy)/((dx*dx+dy*dy)||1e-9)));
   387	    const dd=Math.hypot(px-(x1+t*dx),py-(y1+t*dy));
   388	    if(dd<minD)minD=dd;
   389	    if(((y1>py)!==(y2>py))&&px<(x2-x1)*(py-y1)/((y2-y1)||1e-9)+x1)inside=!inside;
   390	  }
   391	  return inside?0:minD;
   392	}
   393	const LINES_=$('lines');
   394	LINES_.addEventListener('mouseover',e=>{const row=e.target.closest('.rowline');if(row)drawBoxes(+row.dataset.i);});
   395	LINES_.addEventListener('mouseout',e=>{if(!e.relatedTarget||!e.relatedTarget.closest('.rowline'))drawBoxes(null);});
   396	LINES_.addEventListener('click',e=>{
   397	  const row=e.target.closest('.rowline');if(!row)return;
   398	  const i=+row.dataset.i;
   399	  window.__sel=(window.__sel===i)?null:i;
   400	  LINES_.querySelectorAll('.rowline').forEach(r=>r.classList.toggle('sel',+r.dataset.i===window.__sel));
   401	  drawBoxes(null);
   402	});
   403	$('canvas').addEventListener('click',e=>{
   404	  const c=$('canvas');
   405	  if(!window.__res||!window.__scale)return;
   406	  const rc=c.getBoundingClientRect();
   407	  const px=(e.clientX-rc.left)*(c.width/rc.width);
   408	  const py=(e.clientY-rc.top)*(c.height/rc.height);
   409	  let best=null,bd=1e9;
   410	  window.__res.lines.forEach(ln=>{if(!ln.box)return;
   411	    const dd=pointBoxDist(px,py,ln.box);if(dd<bd){bd=dd;best=ln.index;}});
   412	  if(best==null||bd>30)return;
   413	  const row=LINES_.querySelector(`.rowline[data-i="${best}"]`);
   414	  if(row){window.__sel=(window.__sel===best)?null:best;
   415	    LINES_.querySelectorAll('.rowline').forEach(r=>r.classList.toggle('sel',+r.dataset.i===window.__sel));
   416	    drawBoxes(null);row.scrollIntoView({block:'nearest',behavior:'smooth'});}
   417	});
