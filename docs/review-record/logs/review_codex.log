   500	@app.on_event("startup")
   501	def startup():
   502	    req = state["requested_device"]
   503	    if req == "auto":
   504	        candidates = ["cpu"]
   505	        if paddle.device.is_compiled_with_cuda():
   506	            try:
   507	                if paddle.device.cuda.device_count() > 0:
   508	                    candidates = ["gpu:0", "cpu"]
   509	            except Exception:
   510	                pass
   511	    else:
   512	        candidates = [resolve_device(req)]
   513	
   514	    for i, dev in enumerate(candidates):
   515	        try:
   516	            model = init_model(dev)
   517	            if not warm_predict(model):
   518	                raise RuntimeError("prewarm predict failed")
   519	            state["model"] = model
   520	            state["device"] = dev
   521	            state["warm"] = True
   522	            state["fallback_active"] = i > 0
   523	            state["fallback_reason"] = (
   524	                f"GPU on this host not usable ({state['first_error']}), using {dev}" if i > 0 else None
   525	            )
   526	            log(f"initialized device={dev} lang={state['lang']} det={state['det_model'] or 'default'} "
   527	                f"rec={state['rec_model'] or 'default'} mkldnn={state['enable_mkldnn']} "
   528	                f"fallback_active={state['fallback_active']}")
   529	            return
   530	        except SystemExit:
   531	            raise
   532	        except Exception as exc:
   533	            state["error"] = f"{dev}: {exc}"
   534	            if i == 0:
   535	                state["first_error"] = str(exc)
   536	            log(f"init on {dev} failed: {exc}")
   537	    log("all device candidates failed")
