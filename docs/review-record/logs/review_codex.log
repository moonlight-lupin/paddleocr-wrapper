   134	def result_fields(res) -> dict:
   135	    """Pull text/score/box fields from a paddleocr 3.x OCRResult, defensively."""
   136	    texts = scores = polys = None
   137	    try:
   138	        texts = res["rec_texts"]
   139	        scores = res["rec_scores"]
   140	        polys = res["rec_polys"]
   141	    except Exception:
   142	        try:
   143	            j = res.json["res"]
   144	            texts, scores, polys = j["rec_texts"], j["rec_scores"], j["rec_polys"]
   145	        except Exception:
   146	            pass
   147	    if texts is None:
   148	        return {"lines": [], "text": ""}
