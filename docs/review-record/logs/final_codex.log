+
+    def _pump(self, stream, out: queue.Queue):
+        """Reader thread bound to ONE queue: a stale pump thread can never
+        inject into a replacement child's queue (codex R2 finding)."""
+        try:
+            for line in stream.stdout:
+                out.put(line)
+            out.put(None)
+        except Exception:
