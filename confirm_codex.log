   251	        try:
   252	            for line in self.proc.stdout:
   253	                self.lines.put(line)
   254	            self.lines.put(None)
   255	        except Exception:
   256	            self.lines.put(None)
   257	
   258	    def _read(self, timeout_s: float) -> str | None:
   259	        try:
   260	            return self.lines.get(timeout=timeout_s)
   261	        except queue.Empty:
   262	            return ""
   263	
   264	    def _spawn(self, timeout_s: float = SPAWN_TIMEOUT_S):
   265	        env = {**os.environ, "PYTHONIOENCODING": "utf-8"}
   266	        self.proc = subprocess.Popen(
   267	            [self.python_exe, self.script_path],
   268	            stdin=subprocess.PIPE,
   269	            stdout=subprocess.PIPE,
   270	            text=True,
   271	            encoding="utf-8",
   272	            cwd=os.path.dirname(os.path.abspath(self.script_path)) or None,
   273	            env=env,
   274	        )
   275	        self.lines = queue.Queue()
   276	        threading.Thread(target=self._pump, daemon=True).start()
   277	        for _ in range(self.MAX_NOISE_LINES):  # skip child-side stdout noise
   278	            line = self._read(timeout_s)
   279	            if line == "":  # timeout or dead child
   280	                raise RuntimeError("rapid worker handshake timed out")
   281	            if line is None or line.strip() == "":
   282	                raise RuntimeError("rapid worker died before READY")
   283	            if line.strip() == "READY":
   284	                log("rapidocr tier spawned")
   285	                return
   286	        raise RuntimeError("rapid worker did not report READY")
   287	
   288	    # -- request path -------------------------------------------------------
   289	
   290	    def call(self, img: np.ndarray) -> tuple[dict | None, str]:
   291	        """Run OCR on a decoded BGR array. Returns (fields, reason).
   292	
   293	        Transport failures kill + respawn the child (one respawn per request).
   294	        A per-image OCR failure ({ok:false}) keeps the healthy child alive and
   295	        only fails this request. None = tier-2 unavailable for this request.
   296	        """
   297	        ok, buf = cv2.imencode(".png", img)
   298	        if not ok:
   299	            return None, "image encode failed"
   300	        payload = json.dumps({"image": base64.b64encode(buf.tobytes()).decode("ascii")})
   301	
   302	        for attempt in (1, 2):
   303	            try:
   304	                if self.proc is None or self.proc.poll() is not None:
   305	                    self._kill()
   306	                    self._spawn()
   307	                writer = threading.Thread(
   308	                    target=lambda: (self.proc.stdin.write(payload + "\n"), self.proc.stdin.flush()),
   309	                    daemon=True,
   310	                )
   311	                writer.start()
   312	                deadline = time.time() + self.CALL_TIMEOUT_S
   313	                while True:
   314	                    remaining = deadline - time.time()
   315	                    if remaining <= 0:
   316	                        raise RuntimeError(f"rapid worker timed out after {self.CALL_TIMEOUT_S}s")
   317	                    line = self._read(remaining)
   318	                    if not line:  # queue timeout or child death
   319	                        raise RuntimeError("rapid worker timed out or died")
   320	                    if line.startswith("OCR "):
   321	                        resp = json.loads(line[4:])
   322	                        if resp.get("ok"):
   323	                            return {"lines": resp["lines"], "text": resp["text"]}, "rapidocr-cpu"
   324	                        # per-image failure: child is alive and answered; do not kill it
   325	                        return None, f"rapid worker OCR failed: {resp.get('error')}"
   326	                    # else: noise line, keep reading
   327	            except Exception as exc:
   328	                state["rapid"]["failures"] += 1  # counts attempts, may exceed uses
   329	                log(f"rapidocr tier attempt {attempt} failed: {exc}")
   330	                self._kill()
   331	        return None, "tier2 call failed"
   332	
   333	    def probe(self) -> str | None:
   334	        """Boot-time health check: spawn + handshake. None on success, error text otherwise."""
   335	        try:
   336	            self._kill()
   337	            self._spawn()
   338	            return None
   339	        except Exception as exc:
   340	            self._kill()
   341	            return str(exc)
   342	
   343	    def stop(self):
   344	        self._kill()
   345	
   346	
   347	def rapid_fields(img: np.ndarray) -> tuple[dict | None, str]:
   348	    """Tier 2 attempt. Returns (fields, 'rapidocr-cpu') or (None, reason)."""
   349	    w = state["rapid_worker"]
   350	    if w is None or state["rapid"]["circuit_open"]:
   351	        return None, "tier2 disabled" if w is None else "tier2 circuit open"
   352	    state["rapid"]["uses"] += 1
   353	    fields, why = w.call(img)
   354	    if fields is None:
   355	        # transport / OCR failure: count the request and consider the breaker
   356	        state["rapid"]["failure_requests"] += 1
   357	        if state["rapid"]["failure_requests"] >= 2:
   358	            state["rapid"]["circuit_open"] = True
   359	            log("tier 2 circuit opened: repeated rapid worker failures (reset only on service restart)")
   360	        return None, why
   361	    state["rapid"]["failure_requests"] = 0  # a successful call closes the failure streak
   362	    lines = fields["lines"]
   363	    confs = [ln["confidence"] for ln in lines if ln.get("confidence") is not None]
   364	    # Gate takes the minimum over all lines; a line with missing confidence is
   365	    # treated as missing evidence, so the image re-runs on tier 3 (codex finding).
   366	    if len(confs) < len(lines):
   367	        state["rapid"]["gated"] += 1
   368	        log("tier2 output has line(s) with missing confidence; re-running on paddle CPU")
   369	        return None, "tier2 conf gate (missing confidence on a line)"
   370	    min_conf = min(confs) if confs else 0.0  # includes the zero-lines-as-0.0 rule
   371	    if min_conf < state["conf_gate"]:
   372	        state["rapid"]["gated"] += 1
   373	        log(f"tier2 min_conf {min_conf:.3f} < gate {state['conf_gate']}; re-running on paddle CPU")
   374	        return None, f"tier2 conf gate (min_conf {min_conf:.3f})"
   375	    return fields, "rapidocr-cpu"
   376	
   377	
   378	def tier3_fields(img: np.ndarray, reason: str) -> tuple[dict, str]:
   379	    """Tier 3: paddle CPU in its own model slot; never displaces the GPU model."""
   380	    # explicit CPU boots / forced paddle-cpu reuse the boot model when it IS cpu
   381	    if state["requested_device"] == "cpu" and state["device"] == "cpu" and state["model"] is not None:
   382	        return _predict_fields(state["model"], img, "cpu")
   383	    if state["force_tier"] == "paddle-cpu" and state["device"] == "cpu" and state["model"] is not None:
   384	        return _predict_fields(state["model"], img, "cpu")
   385	    if state["cpu_model"] is None:
   386	        log(f"initializing paddle CPU tier 3 ({reason})")
   387	        model = init_model("cpu")
   388	        if not warm_predict(model):
   389	            raise HTTPException(status_code=500, detail={"error": "paddle predict failed: tier-3 CPU prewarm failed"})
   390	        state["cpu_model"] = model
   391	    state["fallback_active"] = True
   392	    if not state["fallback_reason"]:
   393	        state["fallback_reason"] = reason
   394	    return _predict_fields(state["cpu_model"], img, "cpu")
   395	
   396	
   397	def ensure_fields(img: np.ndarray) -> tuple[dict, str]:
   398	    """Engine chain. Returns (fields, device_label). Raises HTTPException only if everything fails."""
   399	    ft = state["force_tier"]
   400	    if ft == "rapidocr":
   401	        fields, why = rapid_fields(img)
   402	        if fields is not None:
   403	            return fields, why
   404	        return tier3_fields(img, f"tier2 unavailable ({why})")
   405	    if ft == "paddle-cpu":
   406	        return tier3_fields(img, "forced paddle-cpu")
   407	    if ft == "gpu":
   408	        if state["model"] is None:
   409	            raise HTTPException(status_code=503, detail={"error": "model not initialized", "detail": state["error"]})
   410	        res = state["model"].predict(img)
   411	        return results_to_fields(res), state["device"]
   412	    if state["model"] is None:
   413	        raise HTTPException(status_code=503, detail={"error": "model not initialized", "detail": state["error"]})
   414	    if state["device"] == "cpu":
   415	        # boot-time GPU failure (or --device cpu): serve paddle CPU, but keep
   416	        # tier 2 first in auto mode - the fast tier is the point of auto.
   417	        if state["requested_device"] == "auto":
   418	            fields, _ = rapid_fields(img)
   419	            if fields is not None:
   420	                return fields, "rapidocr-cpu"
   421	        res = state["model"].predict(img)
   422	        return results_to_fields(res), "cpu"
   423	    # tier 1: paddle GPU. Per-request retry keeps auto-recovery: a transient
   424	    # VRAM conflict repairs itself on a later request without a restart. The
   425	    # persistent-failure cost is one fast exception per request; /health
   426	    # tracks it via gpu_runtime_failures.
   427	    try:
   428	        res = state["model"].predict(img)
   429	        if state["fallback_active"]:
   430	            state["fallback_active"] = False
   431	            state["fallback_reason"] = None
   432	            log("GPU recovered: fallback state cleared")
   433	        return results_to_fields(res), state["device"]
   434	    except Exception as exc:
   435	        if state["requested_device"] != "auto":
   436	            # explicit --device gpu: original semantics, no downward chain
   437	            raise HTTPException(status_code=500, detail={"error": "paddle predict failed", "detail": str(exc)}) from exc
   438	        state["gpu_runtime_failures"] += 1
   439	        reason = f"GPU runtime failure ({state['gpu_runtime_failures']}): {exc}"
   440	        state["fallback_active"] = True
   441	        state["fallback_reason"] = reason
   442	        log(f"{reason}; descending engine chain")
   443	        fields, why = rapid_fields(img)
   444	        if fields is not None:
   445	            return fields, "rapidocr-cpu"
   446	        return tier3_fields(img, f"tier 2 unavailable ({why}); {reason}")
   447	
