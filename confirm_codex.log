   781	def init_model(dev):
   782	    kwargs = dict(
   783	        lang=state["lang"],
   784	        device=dev,
   785	        enable_mkldnn=state["enable_mkldnn"],
   786	        use_doc_orientation_classify=False,
   787	        use_doc_unwarping=False,
   788	        use_textline_orientation=False,
   789	    )
   790	    # Optional explicit model overrides. When set, paddleocr auto-downloads
   791	    # the named model on first start. Note: explicit names make lang ignored.
   792	    if state.get("det_model"):
   793	        kwargs["text_detection_model_name"] = state["det_model"]
   794	    if state.get("rec_model"):
   795	        kwargs["text_recognition_model_name"] = state["rec_model"]
   796	    return PaddleOCR(**kwargs)
