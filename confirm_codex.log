   799	@app.on_event("startup")
   800	def startup():
   801	    if state["force_tier"] == "rapidocr":
   802	        # test/ops mode: no paddle init at all; tier 2 spawns lazily on first request
   803	        log("skipping paddle init: --force-tier rapidocr (tier 2 only)")
   804	        state["warm"] = True
   805	        return
   806	    # boot-time tier-2 probe: a broken rapid venv shows up here, not during
   807	    # the first GPU outage. A failed probe disables tier 2 for this boot.
   808	    if state["rapid_worker"] is not None:
   809	        err = state["rapid_worker"].probe()
   810	        if err is None:
   811	            log("tier 2 probe ok (worker spawned and answered READY)")
   812	        else:
   813	            state["rapid_worker"] = None
   814	            log(f"tier 2 disabled: boot probe failed: {err}")
   815	    req = state["requested_device"]
   816	    if state["force_tier"] == "paddle-cpu":
   817	        candidates = ["cpu"]
   818	    elif req == "auto":
   819	        candidates = ["cpu"]
   820	        if paddle.device.is_compiled_with_cuda():
   821	            try:
   822	                if paddle.device.cuda.device_count() > 0:
   823	                    candidates = ["gpu:0", "cpu"]
   824	            except Exception:
   825	                pass
   826	    else:
   827	        candidates = [resolve_device(req)]
   828	
   829	    for i, dev in enumerate(candidates):
   830	        try:
   831	            model = init_model(dev)
   832	            if not warm_predict(model):
   833	                raise RuntimeError("prewarm predict failed")
   834	            state["model"] = model
   835	            state["device"] = dev
   836	            state["warm"] = True
   837	            state["fallback_active"] = i > 0
   838	            state["fallback_reason"] = (
   839	                f"GPU on this host not usable ({state['first_error']}), using {dev}" if i > 0 else None
   840	            )
   841	            log(f"initialized device={dev} lang={state['lang']} det={state['det_model'] or 'default'} "
   842	                f"rec={state['rec_model'] or 'default'} mkldnn={state['enable_mkldnn']} "
   843	                f"fallback_active={state['fallback_active']}")
   844	            return
   845	        except SystemExit:
   846	            raise
   847	        except Exception as exc:
   848	            state["error"] = f"{dev}: {exc}"
   849	            if i == 0:
   850	                state["first_error"] = str(exc)
   851	            log(f"init on {dev} failed: {exc}")
   852	    log("all device candidates failed")
