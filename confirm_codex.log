   683	/* box <-> line interactivity */
   684	function drawBoxes(hi){
   685	  const d=window.__res,img=window.__img;
   686	  if(!d||!img||!window.__scale)return;
   687	  const c=$('canvas'),s=window.__scale;
   688	  c.width=img.naturalWidth*s;c.height=img.naturalHeight*s;
   689	  const ctx=c.getContext('2d');
   690	  ctx.drawImage(img,0,0,c.width,c.height);
   691	  ctx.font=`${Math.max(10,11*s)}px ui-monospace,Consolas,monospace`;
   692	  d.lines.forEach(ln=>{
   693	    if(!ln.box)return;
   694	    const active=(hi!=null&&ln.index===hi)||(window.__sel!=null&&ln.index===window.__sel);
   695	    const p=ln.box.map(([x,y])=>[x*s,y*s]);
   696	    ctx.beginPath();ctx.moveTo(p[0][0],p[0][1]);
   697	    for(let i=1;i<4;i++)ctx.lineTo(p[i][0],p[i][1]);
   698	    ctx.closePath();
   699	    if(active){ctx.fillStyle='rgba(138,109,59,.34)';ctx.fill();}
   700	    ctx.lineWidth=Math.max(1,(active?3.2:1.3)*s);
   701	    ctx.strokeStyle=active?'rgba(166,124,46,1)':'rgba(138,109,59,.30)';
   702	    ctx.stroke();
   703	    if(active){ctx.fillStyle='rgba(166,124,46,1)';
   704	      ctx.fillText('#'+ln.index,p[0][0],Math.max(11*s,p[0][1]-4));}
   705	  });
   706	}
   707	function pointBoxDist(px,py,box){
   708	  let inside=false,minD=1e9;
   709	  for(let i=0;i<4;i++){
   710	    const [x1,y1]=box[i],[x2,y2]=box[(i+1)%4];
   711	    const dx=x2-x1,dy=y2-y1;
   712	    const t=Math.max(0,Math.min(1,((px-x1)*dx+(py-y1)*dy)/((dx*dx+dy*dy)||1e-9)));
   713	    const dd=Math.hypot(px-(x1+t*dx),py-(y1+t*dy));
   714	    if(dd<minD)minD=dd;
   715	    if(((y1>py)!==(y2>py))&&px<(x2-x1)*(py-y1)/((y2-y1)||1e-9)+x1)inside=!inside;
   716	  }
   717	  return inside?0:minD;
   718	}
   719	const LINES_=$('lines');
   720	LINES_.addEventListener('mouseover',e=>{const row=e.target.closest('.rowline');if(row)drawBoxes(+row.dataset.i);});
   721	LINES_.addEventListener('mouseout',e=>{if(!e.relatedTarget||!e.relatedTarget.closest('.rowline'))drawBoxes(null);});
   722	LINES_.addEventListener('click',e=>{
   723	  const row=e.target.closest('.rowline');if(!row)return;
   724	  const i=+row.dataset.i;
   725	  window.__sel=(window.__sel===i)?null:i;
   726	  LINES_.querySelectorAll('.rowline').forEach(r=>r.classList.toggle('sel',+r.dataset.i===window.__sel));
   727	  drawBoxes(null);
   728	});
