+
+class RapidWorker:
+    """Persistent rapid_worker.py child process, line-JSON protocol.
+
+    Child prints 'READY' once its engine is loaded, then one 'OCR {json}' line
+    per request. Any other stdout line is skipped as child-side noise.
+    All child reads go through a reader thread + queue with timeouts: a hung
+    child can never block the event loop; it is killed and the request
+    degrades to tier 3.
+    """
+
+    SPAWN_TIMEOUT_S = 120   # model load + READY handshake
+    CALL_TIMEOUT_S = 100    # one image; inside the VM client's 120 s urlopen budget
+    MAX_NOISE_LINES = 100
+
+    def __init__(self, python_exe: str, script_path: str):
+        self.python_exe = python_exe
+        self.script_path = script_path
+        self.proc = None
+        self.lines = queue.Queue()
+
+    # -- child lifecycle ----------------------------------------------------
+
+    def _kill(self):
+        try:
+            if self.proc is not None:
+                self.proc.kill()
+                self.proc.wait(timeout=5)  # reap; no zombie accumulation
+                try:
+                    self.proc.stdin.close()
+                    self.proc.stdout.close()
+                except Exception:
+                    pass
+        except Exception:
+            pass
+        self.proc = None
+
+    def _pump(self):
+        """Reader thread: child stdout -> queue (Windows pipes cannot select())."""
+        try:
+            for line in self.proc.stdout:
+                self.lines.put(line)
+            self.lines.put(None)
+        except Exception:
+            self.lines.put(None)
+
+    def _read(self, timeout_s: float) -> str | None:
+        try:
+            return self.lines.get(timeout=timeout_s)
+        except queue.Empty:
+            return ""
+
+    def _spawn(self, timeout_s: float = SPAWN_TIMEOUT_S):
+        env = {**os.environ, "PYTHONIOENCODING": "utf-8"}
+        self.proc = subprocess.Popen(
+            [self.python_exe, self.script_path],
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            text=True,
+            encoding="utf-8",
+            cwd=os.path.dirname(os.path.abspath(self.script_path)) or None,
+            env=env,
+        )
+        self.lines = queue.Queue()
+        threading.Thread(target=self._pump, daemon=True).start()
+        for _ in range(self.MAX_NOISE_LINES):  # skip child-side stdout noise
+            line = self._read(timeout_s)
+            if line == "":  # timeout or dead child
+                raise RuntimeError("rapid worker handshake timed out")
+            if line is None or line.strip() == "":
+                raise RuntimeError("rapid worker died before READY")
+            if line.strip() == "READY":
+                log("rapidocr tier spawned")
+                return
+        raise RuntimeError("rapid worker did not report READY")
+
+    # -- request path -------------------------------------------------------
+
+    def call(self, img: np.ndarray) -> tuple[dict | None, str]:
+        """Run OCR on a decoded BGR array. Returns (fields, reason).
+
+        Transport failures kill + respawn the child (one respawn per request).
+        A per-image OCR failure ({ok:false}) keeps the healthy child alive and
+        only fails this request. None = tier-2 unavailable for this request.
+        """
+        ok, buf = cv2.imencode(".png", img)
+        if not ok:
+            return None, "image encode failed"
+        payload = json.dumps({"image": base64.b64encode(buf.tobytes()).decode("ascii")})
+
+        for attempt in (1, 2):
+            try:
+                if self.proc is None or self.proc.poll() is not None:
+                    self._kill()
+                    self._spawn()
+                writer = threading.Thread(
+                    target=lambda: (self.proc.stdin.write(payload + "\n"), self.proc.stdin.flush()),
+                    daemon=True,
+                )
+                writer.start()
+                deadline = time.time() + self.CALL_TIMEOUT_S
+                while True:
+                    remaining = deadline - time.time()
+                    if remaining <= 0:
+                        raise RuntimeError(f"rapid worker timed out after {self.CALL_TIMEOUT_S}s")
+                    line = self._read(remaining)
+                    if not line:  # queue timeout or child death
+                        raise RuntimeError("rapid worker timed out or died")
+                    if line.startswith("OCR "):
+                        resp = json.loads(line[4:])
+                        if resp.get("ok"):
+                            return {"lines": resp["lines"], "text": resp["text"]}, "rapidocr-cpu"
+                        # per-image failure: child is alive and answered; do not kill it
+                        return None, f"rapid worker OCR failed: {resp.get('error')}"
+                    # else: noise line, keep reading
+            except Exception as exc:
+                state["rapid"]["failures"] += 1  # counts attempts, may exceed uses
+                log(f"rapidocr tier attempt {attempt} failed: {exc}")
+                self._kill()
+        return None, "tier2 call failed"
+
+    def probe(self) -> str | None:
+        """Boot-time health check: spawn + handshake. None on success, error text otherwise."""
+        try:
+            self._kill()
+            self._spawn()
+            return None
+        except Exception as exc:
+            self._kill()
+            return str(exc)
+
+    def stop(self):
+        self._kill()
+
