   769	def warm_predict(model) -> bool:
   770	    """Run a tiny predict to prove the device actually works."""
   771	    img = np.full((64, 200, 3), 255, dtype=np.uint8)
   772	    cv2.putText(img, "warmup", (10, 40), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 0, 0), 2)
   773	    try:
   774	        model.predict(img)
   775	        return True
   776	    except Exception as exc:
   777	        log(f"prewarm predict failed: {exc}")
   778	        return False
